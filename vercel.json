{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build && mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/internal/idempotency/sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/internal/catalog/refresh",
      "schedule": "15 3 * * *"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
