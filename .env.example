# PostgreSQL connection string. A managed provider keeps sslmode=require.
DATABASE_URL=postgres://comuna:comuna@localhost:5434/comuna_sport

# Optional: listening port (hosting platforms inject their own; local default 3000).
# PORT=3000

# Optional: comma-separated allowlist of absolute origins (scheme://host[:port]).
# Unset or blank keeps the open default used by the demo (cors() defaults).
# CORS_ALLOWED_ORIGINS=https://your-spa.example

# Optional: token that protects GET /internal/idempotency/sweep. When set, the
# scheduler must send "Authorization: Bearer <value>"; Vercel does that for the
# cron declared in vercel.json. Unset means the route is not routable (404).
# Use a random string of 16+ characters. Never commit a real value.
# CRON_SECRET=
